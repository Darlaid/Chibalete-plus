# .dockerignore — mantiene los build contexts de Docker reproducibles, livianos
# y sin secretos. Aplica a Dockerfile.api y Dockerfile.front.
#
# NO excluir: server/, scripts/, package.json, package-lock.json ni el código
# fuente del front (pages/, components/, etc.) — los Dockerfiles los necesitan.

# ── Control de versiones / metadatos ───────────────────────────────────────
.git
.gitignore
.github
.githooks

# ── Dependencias y artefactos de build (se generan DENTRO de la imagen) ─────
**/node_modules
dist
dist-ssr

# ── Contenido de runtime servido por la API, NO por el front ────────────────
# nginx.prod.conf proxea `location /uploads/` → http://api. Embeber public/uploads
# en la imagen front es peso muerto: ~1 GB que nginx nunca sirve y que rompe la
# reproducibilidad (el tamaño dependería del estado del filesystem local).
public/uploads

# ── Datos locales, snapshots y paquetes — nunca parte de una imagen ─────────
data
data-critical
_prod_snapshot_
_api_snapshot_
chibaleteplus
deployment_package
*.tar
*.tar.gz
*.tgz
*.zip
*.log

# ── Secretos / entorno local ────────────────────────────────────────────────
.env
.env.*

# ── Evidencia operativa y documentación — nunca parte de una imagen ─────────
# CHP-RELEASE-IMAGE-01A: ningún Dockerfile copia estos árboles, pero mantenerlos
# fuera del build context evita que material de auditoría (informes, anexos,
# manifiestos, planes de backup) entre por error en una capa futura y reduce el
# tamaño del contexto enviado al daemon.
ops
docs
loadtest
# scripts/: .gitignore ignora `/scripts/*` y re-trackea sólo los legítimos, así
# que el árbol de trabajo contiene decenas de archivos ad-hoc. Ningún Dockerfile
# los necesita; excluirlos del contexto evita hornearlos desde una copia sucia.
scripts
*.pem
*.key
*.p12
secrets

# ── Misc dev ────────────────────────────────────────────────────────────────
.vscode
.idea
.claude
npm-debug.log*
