[Unit]
Description=Chibalete+ backup verification, weekly
Documentation=file:/opt/chibalete-backup/README.md

[Timer]
# DEST_DECISION.md decision 4 / BACKUP_01B_DESIGN.md §10: verificacion semanal.
OnCalendar=Sun *-*-* 05:00:00
RandomizedDelaySec=1800
Persistent=true
AccuracySec=1min
Unit=backup-verify.service

[Install]
WantedBy=timers.target
