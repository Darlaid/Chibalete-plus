# CHP-BACKUP-01B — plantilla de /etc/chibalete-backup/backup.env
#
# ESTE ARCHIVO NO CONTIENE NI DEBE CONTENER VALORES REALES.
# Es una plantilla versionada. Los valores los aporta el operador
# DIRECTAMENTE EN EL VPS, nunca en Git.
#
# Instalacion (fuera del alcance de CHP-BACKUP-01B-1):
#
#   install -d -m 0700 -o root -g root /etc/chibalete-backup
#   install -m 0400 -o root -g root backup.env.example /etc/chibalete-backup/backup.env
#   # editar en el VPS y sustituir los CHANGEME
#   printf '%s' '<passphrase>' > /etc/chibalete-backup/restic-password
#   chown root:root /etc/chibalete-backup/restic-password
#   chmod 0400      /etc/chibalete-backup/restic-password
#
# Ambos archivos DEBEN quedar root:root 0400. El runner falla cerrado si no.
# La passphrase NO va aqui: vive en su propio archivo (BACKUP_01B_DESIGN.md §4).

# --- Contrato S3-compatible de Backblaze B2 ---------------------------------
# El keyID / applicationKey de B2 se usan directamente como credenciales AWS.
# La Application Key debe estar limitada EXCLUSIVAMENTE al bucket aprobado.
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME

# Region del endpoint S3 de B2 (p. ej. us-west-004). Sin valor real aqui.
AWS_DEFAULT_REGION=CHANGEME

# Endpoint S3 explicito + bucket privado dedicado + prefijo exclusivo:
#   s3:https://s3.<region>.backblazeb2.com/<bucket-privado>/<prefijo-chibalete>
RESTIC_REPOSITORY=CHANGEME

# Ruta EXACTA del archivo de passphrase. El runner rechaza cualquier otra.
RESTIC_PASSWORD_FILE=/etc/chibalete-backup/restic-password

# --- Opcional ---------------------------------------------------------------
# Cache de restic fuera de /var/www/chibalete. Si se omite, restic usa su
# ubicacion por defecto bajo $HOME.
#RESTIC_CACHE_DIR=/var/backups/chibalete-backup/cache

# Claves PROHIBIDAS en este archivo (el runner aborta si aparecen):
#   RESTIC_PASSWORD   -> la passphrase va en restic-password
#   B2_ACCOUNT_ID     -> se usa el contrato S3, no la API nativa B2
#   B2_ACCOUNT_KEY
