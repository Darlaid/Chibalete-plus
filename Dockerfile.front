# ─────────────────────────────────────────────────────────────
# Dockerfile.front — Chibalete+ Frontend (SPA)
#
# Stage 1: build the Vite/React app
# Stage 2: serve with nginx
# ─────────────────────────────────────────────────────────────

# ── Stage 1: build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (layer cache)
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

# Copy all frontend source
COPY index.html index.tsx index.css App.tsx metadata.json vite.config.ts tsconfig.json ./
# CHP-CONTENT-CANONICAL-2026-01 3E.3 — entrada del lector EPUB + motor foliate vendorizado
COPY epub-reader.html epub-reader.tsx ./
COPY vendor/foliate-js/ ./vendor/foliate-js/
COPY pages/       ./pages/
COPY components/  ./components/
COPY context/     ./context/
COPY hooks/       ./hooks/
COPY services/    ./services/
COPY types/       ./types/
COPY utils/       ./utils/
COPY config/      ./config/
COPY engines/     ./engines/
COPY public/      ./public/

# Build production bundle → /app/dist
RUN npm run build

# ── Stage 2: serve ───────────────────────────────────────────
# SEC-DEPS-02 Lote E — la rama 1.27 de nginx está cerrada: `nginx:1.27-alpine`
# quedó congelado en Alpine 3.21.3 (2025-04-16) con 59 HIGH/CRITICAL de OS
# (OpenSSL, libxml2, pcre2, curl, libexpat, musl…). 1.30 es la rama ESTABLE
# vigente de la misma imagen oficial; nginx.prod.conf no usa directivas que
# cambien entre ramas (validado con `nginx -t`). Pinneada por digest.
FROM nginx:1.30-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951 AS runner

# SEC-ACCOUNT-01 — piso de versión sobre la base pinneada (mismo patrón que
# Dockerfile.api, Lote E): CVE-2026-111497 en brotli-libs (fix 1.2.1-r0, repo de
# Alpine 3.24). Si el repo no lo ofrece, el build FALLA en vez de construir en
# silencio con la versión vulnerable.
RUN apk add --no-cache 'brotli-libs>=1.2.1-r0'

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy the built SPA
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config that handles SPA routing and proxies /api/ to the API container
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
