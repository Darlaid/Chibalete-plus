# ─────────────────────────────────────────────────────────────
# Dockerfile.front — Chibalete+ Frontend (SPA)
#
# Stage 1: build the Vite/React app
# Stage 2: serve with nginx
# ─────────────────────────────────────────────────────────────

# ── Stage 1: build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (layer cache)
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

# Copy all frontend source
COPY index.html index.tsx index.css App.tsx metadata.json vite.config.ts tsconfig.json ./
# CHP-CONTENT-CANONICAL-2026-01 3E.3 — entrada del lector EPUB + motor foliate vendorizado
COPY epub-reader.html epub-reader.tsx ./
COPY vendor/foliate-js/ ./vendor/foliate-js/
COPY pages/       ./pages/
COPY components/  ./components/
COPY context/     ./context/
COPY hooks/       ./hooks/
COPY services/    ./services/
COPY types/       ./types/
COPY utils/       ./utils/
COPY config/      ./config/
COPY engines/     ./engines/
COPY public/      ./public/

# Build production bundle → /app/dist
RUN npm run build

# ── Stage 2: serve ───────────────────────────────────────────
# SEC-DEPS-02 Lote E — la rama 1.27 de nginx está cerrada: `nginx:1.27-alpine`
# quedó congelado en Alpine 3.21.3 (2025-04-16) con 59 HIGH/CRITICAL de OS
# (OpenSSL, libxml2, pcre2, curl, libexpat, musl…). 1.30 es la rama ESTABLE
# vigente de la misma imagen oficial; nginx.prod.conf no usa directivas que
# cambien entre ramas (validado con `nginx -t`). Pinneada por digest.
# V9 BI-65B-C — digest avanzado a la imagen oficial con nginx 1.30.7-r1 (antes
# 1.30.6-r1): CVE-2026-113425, CVE-2026-121810, CVE-2026-123007, CVE-2026-123633
# y CVE-2026-123634 (HIGH), fix 1.30.7-r0 (Trivy de CI en 56ba051).
FROM nginx:1.30-alpine@sha256:caf4e1e032a20f9c3c5e28fc7f25ffd768ad8677b4975c54193075997b3a97e3 AS runner

# SEC-ACCOUNT-01 — piso de versión sobre la base pinneada (mismo patrón que
# Dockerfile.api, Lote E): CVE-2026-111497 en brotli-libs (fix 1.2.1-r0, repo de
# Alpine 3.24). Si el repo no lo ofrece, el build FALLA en vez de construir en
# silencio con la versión vulnerable.
# SEC-FRONT-CURL-01 — mismo patrón: CVE-2026-92392 en curl/libcurl (fix
# 8.23.0-r0, repo main de Alpine 3.24). Solo actualiza esos dos paquetes.
# SEC-IMG-FRONT-01 — mismo patrón: CVE-2026-117610 y CVE-2026-118370 (HIGH) en
# libexpat 2.9.0-r0 de la base (dependencia de fontconfig); fix 2.10.0-r0, repo
# main de Alpine 3.24. El digest de nginx:1.30-alpine (amd64) no ha cambiado.
# SEC-FRONT-LIBXSLT-01 (V8.1-PROD-01B) — mismo patrón: CVE-2026-87636 y CVE-2026-9947 (HIGH) en
# libxslt 1.1.43-r3 de la base; fix 1.1.43-r4, repo de Alpine 3.24 (Trivy de CI en 25d4b52).
# V9 BI-65B-C — mismo patrón: CVE-2026-86144 (HIGH) en libxml2 2.13.9-r2 de la
# base; fix 2.13.9-r3, repo main de Alpine 3.24.
RUN apk add --no-cache 'brotli-libs>=1.2.1-r0' 'curl>=8.23.0-r0' 'libcurl>=8.23.0-r0' 'libexpat>=2.10.0-r0' 'libxslt>=1.1.43-r4' 'libxml2>=2.13.9-r3'

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy the built SPA
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config that handles SPA routing and proxies /api/ to the API container
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
