# ─────────────────────────────────────────────────────────────
# Dockerfile.api — Chibalete+ Backend API
#
# CHP-RELEASE-IMAGE-01A — imagen REPRODUCIBLE y AUTOSUFICIENTE.
#
# Multi-stage:
#   Stage 1 (builder) — resuelve node_modules con el toolchain
#                       python3/make/g++ (better-sqlite3 nativo).
#   Stage 2 (runtime) — imagen final SIN toolchain de build.
#
# Qué cambió respecto de la imagen af319ca y POR QUÉ:
#
#   1. `npm ci` con package-lock.json, en lugar de `npm install` sin lockfile.
#      La imagen af319ca se construía copiando SOLO package.json y resolviendo
#      los rangos semver en tiempo de build. Resultado: quedó con multer 2.1.1
#      cuando el lockfile fija 2.2.0, y sin @opentelemetry/core. El build dejaba
#      de ser reproducible: dos builds del mismo commit podían diferir.
#
#      El comentario histórico decía que `npm ci` rompía en alpine porque el
#      lockfile se genera en Windows y pinnea binarios win32. Se verificó y la
#      premisa está obsoleta: los 8 paquetes con `os: win32` del lockfile son
#      TODOS `optional: true`, y no hay ningún paquete no-opcional y no-dev sin
#      soporte linux. npm ci los omite por plataforma sin fallar.
#
#   2. Se copian `utils/` y `engines/`, que faltaban. Son imports de RUNTIME:
#         server/server.js               → ../utils/groupDiagnosis.mjs,
#                                          ../utils/membershipGovernance.mjs,
#                                          ../utils/studentStatus.mjs
#         server/groupMembershipService.js → ../utils/groupMembership.mjs
#         server/metrics/metricsRouterV2.mjs → ../../engines/metrics/*.mjs
#      Sin ellos la imagen sólo arrancaba gracias a bind mounts de código.
#
#   3. Se retiró el bootstrap de /app/data. La imagen NO debe contener stores
#      (incluía bundles_db.json). `server.js` autocrea los JSON ausentes al
#      arrancar, así que el bootstrap era redundante. data/, data-critical/ y
#      uploads/ llegan siempre por bind mount.
#
#   4. Imagen base pinneada por digest, no por tag flotante.
#
# El contenedor corre como root a propósito: `server/lib/secretFile.js` exige
# que /app/secrets/admin_secret pertenezca al UID/GID EFECTIVOS del proceso, y
# el secreto productivo es root:root 0400. Cambiar de usuario rompería el
# contrato file-only del admin secret.
#
# Entry point: server/server.js  (ESM, "type":"module")
# ─────────────────────────────────────────────────────────────

# ── Stage 1: builder ─────────────────────────────────────────
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

# Toolchain para node-gyp / better-sqlite3 — solo en el builder.
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Instalación REPRODUCIBLE: npm ci exige que package.json y package-lock.json
# estén sincronizados y falla si divergen. Copiar ambos es lo que garantiza que
# la imagen refleje exactamente el lockfile versionado.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# ── Stage 2: runtime ─────────────────────────────────────────
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS runtime

# dumb-init → manejo correcto de señales para PID 1.
RUN apk add --no-cache dumb-init

WORKDIR /app

# Trazabilidad del release. GIT_SHA alimenta el fallback de `commit` en
# healthHandler.js cuando server/.deploy-info todavía no está montado.
# `deployed_at` NO se fija en build a propósito: es exclusivo de .deploy-info y
# debe reflejar el despliegue real, no la construcción de la imagen.
ARG GIT_SHA=unknown
ARG RELEASE_TAG=unknown
ENV GIT_SHA=${GIT_SHA}
ENV CHIBALETE_RELEASE=${RELEASE_TAG}

# Manifests: package.json resuelve "type":"module" y es fallback de versión en
# healthHandler. El lockfile viaja para poder auditar la imagen a posteriori.
COPY package.json package-lock.json ./

# node_modules ya resuelto y compilado en el builder. builder y runtime
# comparten EXACTAMENTE la misma base pinneada → ABI musl/alpine compatible:
# el binario nativo de better-sqlite3 es válido sin recompilar.
COPY --from=builder /app/node_modules ./node_modules

# ── Código runtime versionado ────────────────────────────────
# Los tres son necesarios para arrancar. Ver nota (2) en la cabecera.
COPY server/  ./server/
COPY utils/   ./utils/
COPY engines/ ./engines/

# `scripts/` NO se copia (la imagen af319ca sí lo hacía).
#
# Razones:
#   - Ningún módulo de runtime importa nada de scripts/ (verificado).
#   - Ningún runbook de despliegue ejecuta scripts dentro del contenedor: los
#     scripts operacionales corren en el host.
#   - .gitignore ignora `/scripts/*` y re-trackea sólo 23 scripts legítimos por
#     negación explícita. En el árbol de trabajo conviven ~76 archivos ad-hoc
#     ignorados; un `docker build` desde una copia sucia los horneaba en la
#     imagen. Eliminar el COPY suprime ese vector por completo.

# Punto de montaje del secreto administrativo (file-only). Se crea vacío: el
# archivo real llega SIEMPRE por bind mount read-only. Nunca se hornea.
RUN mkdir -p /app/secrets && chmod 0500 /app/secrets

# Quitar el CLI de npm: el container corre `node server/server.js` y NUNCA
# invoca npm en runtime. Saca sus deps vulnerables del filesystem.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# Metadata de trazabilidad.
LABEL org.opencontainers.image.title="chibalete-api" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${RELEASE_TAG}" \
      org.opencontainers.image.base.name="node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293"

EXPOSE 3000

# Healthcheck real — usa /api/health/ready (readiness multi-capa, NO liveness).
# node -e + fetch nativo (node 20): sin curl, sin bash, sin scripts.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health/ready').then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"]

# dumb-init para que Node reciba SIGTERM correctamente.
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server/server.js"]
