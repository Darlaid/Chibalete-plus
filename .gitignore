# Sprint 022.10 freeze — SQLite progress + events DBs (local dev only).
# Estos archivos los crea el backend al correr local; jamás deben
# committearse (drift de fixtures + tamaño + datos sensibles).
# El esquema vive en server.js / better-sqlite3 setup; no se versiona.
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data-critical/*.db
/data-critical/*.db-shm
/data-critical/*.db-wal

# Lockfile-history snapshots
/package-lock.json.pre-*.json

# IDE / agent / prompt scratch
/.claude/
/Prompts/

# Snapshot working dirs (used by Phase 5 reconcile sprints)
/_prod_snapshot_/
/_api_snapshot_/

# Ad-hoc scripts (whole directory ignored per sprint scope; legitimate scripts must be re-tracked explicitly).
# Patrón `/scripts/*` (no trailing slash) permite negaciones; con `/scripts/`
# git no descendía y bloqueaba re-incluir hijos.
/scripts/*
!/scripts/snapshot/
!/scripts/snapshot/**

# Sprint 022 Fase 2B.5/2B.7/2B.8 — scripts operacionales canónicos.
# Estos SÍ se versionan: son la autoridad operacional de backup, deploy
# backend, smoke release y rollback drill. Cualquier cambio pasa por
# commit + scp explícito al VPS.
!/scripts/backup-vps.sh
!/scripts/deploy-backend.sh
!/scripts/deploy-smoke-release.sh
!/scripts/rollback-drill.sh
# Test mock-suite asociado a deploy-backend.sh
!/scripts/__test__/
!/scripts/__test__/deploy-backend-mocked.sh
# Seed local de admin (auditoría manual) — herramienta operacional LOCAL.
# El script aborta si NODE_ENV=production; es seguro versionar. Password
# `admin123` es público por diseño (credencial de auditoría local).
!/scripts/seed-local-admin.mjs
!/scripts/__test__/seed-local-admin.test.mjs

# CHP-ID-CANON-01B — utillaje de aislamiento de tests y comparación shadow.
# Se versionan porque `npm run test:store-isolation` y el test versionado
# scripts/__test__/shadowScopeEquivalence.test.mjs dependen de ellos: sin esto,
# la suite no correría en un clone limpio ni en CI.
!/scripts/test-real-store-guard.mjs
!/scripts/verify-test-store-isolation.mjs
!/scripts/shadow-scope-compare.mjs

# CHP-ID-DEPLOY-PREFLIGHT-01A — utillaje que el job bloqueante de CI necesita.
# Sin versionarlos, `identity-preflight` no podría correr en un clone limpio.
!/scripts/verify-deploy-config.mjs
!/scripts/typecheck-baseline.mjs
!/scripts/typecheck-baseline.txt

# CHP-RELEASE-IMAGE-01A — verificador de integridad de la imagen API.
# Se versiona porque el job bloqueante `image-integrity` de CI lo ejecuta, y
# `npm run test:image-integrity` debe funcionar en un clone limpio.
!/scripts/verify-image-integrity.mjs

# CHP-SEC-ADMIN-EVIDENCE-HARDEN-01B — evidencia operativa segura.
# Se versiona el directorio entero: es la única ruta aprobada para generar
# evidencia de producción, y el job bloqueante `evidence-hardening` de CI
# ejecuta `npm run lint:evidence` y `npm run test:evidence` desde un clone
# limpio. Las fixtures son sintéticas y se generan en tiempo de ejecución, así
# que aquí no vive ninguna cadena con forma de credencial.
!/scripts/security/
!/scripts/security/**

# CHP-ID-GROUPS-RECON-01B — manifiesto de saneamiento y su migrador dry-run.
# Se versionan: son el expediente aprobado que un apply futuro debe ejecutar
# byte a byte, y el test versionado reconMigration.test.mjs depende de ellos.
!/scripts/migrations/
!/scripts/migrations/**

# Audit / diagnostic scripts — READ-ONLY, sin escritura en producción.
# Reusables vía stdin pipe (no requieren despliegue en el VPS). NO integrados
# al pipeline de deploy ni a cron — se ejecutan manualmente cuando hace falta.
!/scripts/audit-school-drift.mjs

# Sprint hardening modo inmersivo (2026-05-11) — pre-build/pre-deploy gate.
# Verifica INV 2/3/4/10/12 sobre el codebase frontend (auto-navegación, storage
# keys no namespaced, setTimeout sin guard, catch que muta playback, engines
# que importan router). npm run lint:immersive-guards.
!/scripts/lint-immersive-guards.mjs

# Sprint 022 Fase 2B.7 — server/.deploy-info es generado por
# scripts/deploy-backend.sh dentro del tarball que se transfiere al VPS.
# Contiene release_tag, git_sha y deployed_at del último deploy.
# JAMÁS debe quedar versionado: se regenera en cada deploy.
# healthHandler.js lo lee si existe; si no, cae a env vars/package.json.
server/.deploy-info
.codex-freeze/

# CHP-STATS-LEGACY-PERF-01A — harness de auditoría del coste legacy. Los
# scripts SÍ se versionan; sus salidas y fixtures generadas, NO.
!/scripts/perf/
!/scripts/perf/**
/bench-results/
/scripts/perf/bench-results/
*.ndjson
*.cpuprofile
*.heapsnapshot
